# Binding, rebinding, and deep copying in Six.

# Initial binding.
count : 1
out(output text(count) + "\n")

# Rebinding.
count = count + 1
out(output text(count) + "\n")

# A nested Group.
original : [
    [1 2]
    [3 4]
]

# Normal binding: alias shares the same Group.
alias : original

# Deep copy: copied is independent.
copied :: original

# Change the first value inside the first nested Group through the alias.
alias[0][0] = 99

# original and alias share one Group (both now 99); copied is independent (still 1).
out(output text(original[0][0]) + "\n")
out(output text(alias[0][0]) + "\n")
out(output text(copied[0][0]) + "\n")
