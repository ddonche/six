# Binding, rebinding, and deep copying in Six.
# Six has no `print`; scalars are written through the output channel.
:line(s)
    out(output s)
    out(output "\n")
.

# Initial binding.
count : 1
line(text(count))

# Rebinding.
count = count + 1
line(text(count))

# A nested Group.
original : [
    [1 2]
    [3 4]
]

# Normal binding: alias shares the same Group.
alias : original

# Deep copy: copied is independent.
copied :: original

# Change the first value inside the first nested Group through the alias.
alias[0][0] = 99

# original and alias share one Group, so both see 99; copied is untouched.
line("original[0][0]: " + text(original[0][0]))
line("alias[0][0]:    " + text(alias[0][0]))
line("copied[0][0]:   " + text(copied[0][0]))
