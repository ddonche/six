# Higher-order operations (spec §39-42) are in the prelude already;
# here we exercise them exactly as the spec defines their use.
>> dbl: [x] >> x * 2
>> even?: [x] >> x % 2 == 0
>> add: [a b] >> a + b

print (map [1 2 3 4 5] dbl)
print (filter [1 2 3 4 5 6 7 8] even?)
print (fold [1 2 3 4 5] 0 add)
print (find [1 3 5 8 9] even?)
