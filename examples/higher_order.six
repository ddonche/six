# map / filter / fold / find are not built in — you write them in Six.
# (spec §39-42, transcribed into the canonical call syntax.)
# Six has no `print`; results are written through the output channel.
:line(s)
    out(output s)
    out(output "\n")
.

# Render a flat Group of scalars as "[a b c]".
:show(g)
    line(_bracket(g 0 "["))
.

:_bracket(g i acc)
    if
        i >= size(g) >> acc + "]"
        i == 0 >> _bracket(g (i + 1) acc + text(g[i]))
        else >> _bracket(g (i + 1) acc + " " + text(g[i]))
    .
.

:fold(list init f i)
    if
        i >= size(list) >> init
        else >> fold(list f(init list[i]) f (i + 1))
    .
.

:map(list f i result)
    if
        i >= size(list) >> result
        else >>
            insert(result f(list[i]))
            map(list f (i + 1) result)
    .
.

:filter(list f i result)
    if
        i >= size(list) >> result
        else >>
            if
                f(list[i]) >> insert(result list[i])
            .
            filter(list f (i + 1) result)
    .
.

:find(list f i)
    if
        i >= size(list) >> ..
        else >>
            if
                f(list[i]) >> list[i]
                else >> find(list f (i + 1))
            .
    .
.

:double(x)
    x * 2
.

:even?(x)
    x % 2 == 0
.

:add(a b)
    a + b
.

:greater-than-five?(x)
    x > 5
.

show(map([1 2 3 4 5] double 0 []))
show(filter([1 2 3 4 5 6 7 8] even? 0 []))
line(text(fold([1 2 3 4 5] 0 add 0)))
line(text(find([1 2 3 4 5 6 7 8] greater-than-five? 0)))
# No element matches, so find returns nil (rendered as an empty line).
line(text(find([1 2 3 4 5] greater-than-five? 0)))
