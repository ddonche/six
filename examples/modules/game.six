# `@hero` loads hero.six and binds its program Group as `hero`.
# Everything after is ordinary Six: keyed Group access and calls.
# Six has no `print`; a line is written through the output channel.
:line(s)
    out(output s)
    out(output "\n")
.

@hero

line(hero["name"] + " enters with " + text(hero["health"]) + " health")

hero["damage"](30)
line("After a hit: " + text(hero["health"]))

hero["heal"](10)
line("After a potion: " + text(hero["health"]))

# A module function is an ordinary value — bind it and call it locally.
hit : hero["damage"]
hit(hero["health"])
line("Final blow — health: " + text(hero["health"]))
