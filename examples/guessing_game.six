# Guessing game (spec §44) in canonical Six syntax.
:ask(answer attempts)
    guess : number(input("Guess a number from 1 to 100: "))
    check(answer attempts guess)
.

:check(answer attempts guess)
    attempts = attempts + 1

    if
        guess == answer >>
            print("Correct!")
            print("Attempts: " + text(attempts))

        else >>
            message :
                if
                    guess < answer >> "Too low."
                    else >> "Too high."
                .

            print(message)
            ask(answer attempts)
    .
.

ask(42 0)
