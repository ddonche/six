# Guessing game (spec §44) in canonical Six syntax.
:ask(answer attempts)
    out(output "Guess a number from 1 to 100: ")
    guess : number(in(input))
    check(answer attempts guess)
.

:check(answer attempts guess)
    attempts = attempts + 1

    if
        guess == answer >>
            out(output "Correct!\n")
            out(output "Attempts: " + text(attempts) + "\n")

        else >>
            message :
                if
                    guess < answer >> "Too low."
                    else >> "Too high."
                .

            out(output message + "\n")
            ask(answer attempts)
    .
.

ask(42 0)
