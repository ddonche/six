# Tiny Inventory
# Canonical Six specimen

##
Alternate syntax accepted by Six:

    if      ?
    if any  ?*
    else    ??

    and     &&
    or      ||
    not     !

Additional numeric postfix forms not needed by this program:

    x**     square
    x**y    power
    x//     square root

Group passing:

    value(group)      passes the existing Group as one argument
    value([group])    passes a new Group containing that Group
    value(<group>)    opens the Group into separate arguments

Flow:

    value >> function(args)

The flowing value becomes the first argument.

    inventory >> total-value(0 0)

is equivalent to:

    total-value(inventory 0 0)

A flow may continue across lines when >> shows that
the expression is not yet complete.
##

TITLE : "Tiny Inventory"
LOW_STOCK : 3
TARGET_STOCK : 12
HIGH_VALUE : 10
MAX_INVENTORY_VALUE : 10,000

warnings : true
last_sale : number ..

inventory : [
    [
        ["name" "coffee"]
        ["qty" 2]
        ["price" 8.50]
        ["case" 6]
        ["note" "Whole bean"]
    ]
    [
        ["name" "rice"]
        ["qty" 1]
        ["price" 4.25]
        ["case" 12]
    ]
    [
        ["name" "beans"]
        ["qty" 14]
        ["price" 3.75]
        ["case" 6]
        ["note" "Black beans"]
    ]
]


:find(items name i)
    if
        i >= size(items) >> -1
        items[i]["name"] == name >> i
        else >> find(items name (i + 1))
    .
.


:each(items action i)
    if
        i >= size(items) >> ..
        else >>
            action(items[i])
            each(items action (i + 1))
    .
.


:at-most(limit)
    :matches(item)
        item["qty"] <= limit
    .

    matches
.


:starts-with(letter)
    :matches(item)
        item["name"][0] == letter
    .

    matches
.


:priority(item)
    item["qty"] == 0 or item["price"] >= HIGH_VALUE
.


:collect-matching(items predicate i result)
    if
        i >= size(items) >> result

        predicate(items[i]) >>
            insert(result items[i])
            collect-matching(items predicate (i + 1) result)

        else >>
            collect-matching(items predicate (i + 1) result)
    .
.


:matching(items predicate)
    result : []
    collect-matching(items predicate 0 result)
    result
.


:item-value(item)
    (item["qty"] * item["price"])~2
.


:total-value(items i total)
    if
        i >= size(items) >> total
        else >>
            total-value(
                items
                (i + 1)
                (total + item-value(items[i]))
            )
    .
.


:total-units(items i total)
    if
        i >= size(items) >> total
        else >>
            total-units(
                items
                (i + 1)
                (total + items[i]["qty"])
            )
    .
.


:money(value)
    "$" + text(value~2)
.


:average-value()
    if
        size(inventory) == 0 >> 0
        else >> (total-value(inventory 0 0) / size(inventory))~2
    .
.


:average-stock()
    if
        size(inventory) == 0 >> 0
        else >> (total-units(inventory 0 0) / size(inventory))~
    .
.


:reorder-cases(item)
    needed : TARGET_STOCK - item["qty"]

    if
        needed <= 0 >> 0
        else >> (needed / item["case"])^
    .
.


:show-cases(item)
    cases : (item["qty"] / item["case"])_
    loose : item["qty"] % item["case"]

    print(
        "Cases: " + text(cases)
        + ", loose: " + text(loose)
    )
.


:status(item)
    if any
        warnings and item["qty"] == 0 >>
            print("  OUT OF STOCK")

        warnings and item["qty"] > 0 and item["qty"] <= LOW_STOCK >>
            print("  Low stock")

        item["qty"] != 0 and item["qty"] % item["case"] != 0 >>
            print("  Loose units")

        item["price"] >= HIGH_VALUE >>
            print("  High-value item")

        not has(item "note") >>
            print("  No note")

        else >>
            print("  Normal")
    .
.


:show-item(item)
    print(
        item["name"]
        + " - "
        + text(item["qty"])
        + " @ "
        + money(item["price"])
        + " = "
        + money(item-value(item))
    )

    status(item)
.


:show-field(item key)
    if
        has(item key) >>
            print(key + ": " + text(item[key]))

        else >>
            print(key + ": -")
    .
.


:list()
    print("")
    print(TITLE)
    print("--------------")

    if
        size(inventory) == 0 >> print("Inventory is empty.")
        else >> each(inventory show-item 0)
    .

    print("")
.


:summary()
    print("")

    total : total-value(inventory 0 0)

    total >>
    money() >>
    print()

    print("Average item value: " + money(average-value()))
    print("Average stock: " + text(average-stock()) + " units")

    if
        total > MAX_INVENTORY_VALUE >>
            print("Inventory exceeds target value.")
    .

    if
        last_sale == .. >> print("No sales yet.")
        else >> print("Last sale: " + money(last_sale))
    .

    print("")
.


:low-stock()
    predicate : at-most(LOW_STOCK)
    items : matching(inventory predicate)

    print("")
    print("LOW STOCK")
    print("---------")

    if
        size(items) == 0 >> print("Nothing is low.")
        else >> each(items show-item 0)
    .

    print("")
.


:priority-report()
    items : matching(inventory priority)

    print("")
    print("PRIORITY")
    print("--------")

    if
        size(items) == 0 >> print("No priority items.")
        else >> each(items show-item 0)
    .

    print("")
.


:initial-report()
    value : input("Initial: ")

    if
        size(value) == 0 >>
            print("No initial entered.")

        else >>
            predicate : starts-with(value[0])
            items : matching(inventory predicate)

            if
                size(items) == 0 >> print("No matching items.")
                else >> each(items show-item 0)
            .
    .
.


:latest()
    if
        size(inventory) == 0 >>
            print("Inventory is empty.")

        else >>
            print("")
            print("LATEST ITEM")
            print("-----------")
            show-item(inventory[$])
            print("")
    .
.


:add-record(name qty price case)
    if
        qty < 0 >> print("Quantity cannot be negative.")
        price < 0 >> print("Price cannot be negative.")
        case <= 0 >> print("Case size must be positive.")

        else >>
            i : find(inventory name 0)

            if
                i >= 0 >>
                    inventory[i]["qty"] = inventory[i]["qty"] + qty
                    print("Updated " + name + ".")

                else >>
                    item : [
                        ["name" name]
                        ["qty" qty]
                        ["price" price]
                        ["case" case]
                    ]

                    insert(inventory item)
                    print("Added " + name + ".")
            .
    .
.


:add-item()
    record : [
        input("Item: ")
        number(input("Quantity: "))
        number(input("Price: "))
        number(input("Case size: "))
    ]

    add-record(<record>)
.


:remove-item()
    name : input("Remove item: ")
    i : find(inventory name 0)

    if
        i >= 0 >>
            remove(inventory i)
            print("Removed " + name + ".")

        else >>
            print("No item named " + name + ".")
    .
.


:change-quantity()
    name : input("Item: ")
    i : find(inventory name 0)

    if
        i >= 0 >>
            qty : number(input("New quantity: "))

            if
                qty < 0 >> print("Quantity cannot be negative.")
                else >>
                    inventory[i]["qty"] = qty
                    print("Quantity changed.")
            .

        else >>
            print("No item named " + name + ".")
    .
.


:receive-one()
    name : input("Receive item: ")
    i : find(inventory name 0)

    if
        i >= 0 >>
            inventory[i]["qty"]++
            print("Received one " + name + ".")

        else >>
            print("No item named " + name + ".")
    .
.


:sell-one()
    name : input("Sell item: ")
    i : find(inventory name 0)

    if
        i < 0 >>
            print("No item named " + name + ".")

        inventory[i]["qty"] == 0 >>
            print(name + " is out of stock.")

        else >>
            inventory[i]["qty"]--
            last_sale = inventory[i]["price"]
            print("Sold one " + name + ".")
    .
.


:add-note()
    name : input("Item: ")
    i : find(inventory name 0)

    if
        i >= 0 >>
            inventory[i]["note"] = input("Note: ")
            print("Note saved.")

        else >>
            print("No item named " + name + ".")
    .
.


:inspect()
    name : input("Item: ")
    i : find(inventory name 0)

    if
        i >= 0 >>
            item : inventory[i]

            print("")
            show-field(item "name")
            show-field(item "qty")
            show-field(item "price")
            show-field(item "case")
            show-field(item "note")
            show-cases(item)

            print("Value: " + money(item-value(item)))
            print("Reorder cases: " + text(reorder-cases(item)))

            status(item)
            print("")

        else >>
            print("Not found.")
    .
.


:preview-restock()
    preview :: inventory

    name : input("Preview item: ")
    i : find(preview name 0)

    if
        i >= 0 >>
            qty : number(input("Units to receive: "))

            if
                qty < 0 >>
                    print("Quantity cannot be negative.")

                else >>
                    preview[i]["qty"] = preview[i]["qty"] + qty

                    print(
                        "Current value: "
                        + money(total-value(inventory 0 0))
                    )

                    print(
                        "Projected value: "
                        + money(total-value(preview 0 0))
                    )
            .

        else >>
            print("No item named " + name + ".")
    .
.


:toggle-warnings()
    if
        warnings >>
            warnings = false
            print("Warnings off.")

        else >>
            warnings = true
            print("Warnings on.")
    .
.


:menu()
    print("")
    print("1. List inventory")
    print("2. Add item")
    print("3. Change quantity")
    print("4. Receive one")
    print("5. Sell one")
    print("6. Remove item")
    print("7. Inspect item")
    print("8. Add note")
    print("9. Low-stock report")
    print("10. Priority report")
    print("11. Items by initial")
    print("12. Latest item")
    print("13. Inventory summary")
    print("14. Preview restock")
    print("15. Toggle warnings")
    print("16. Quit")
    print("")
.


:run()
    menu()
    choice : input("> ")

    if
        choice == "1" >>
            list()
            run()

        choice == "2" >>
            add-item()
            run()

        choice == "3" >>
            change-quantity()
            run()

        choice == "4" >>
            receive-one()
            run()

        choice == "5" >>
            sell-one()
            run()

        choice == "6" >>
            remove-item()
            run()

        choice == "7" >>
            inspect()
            run()

        choice == "8" >>
            add-note()
            run()

        choice == "9" >>
            low-stock()
            run()

        choice == "10" >>
            priority-report()
            run()

        choice == "11" >>
            initial-report()
            run()

        choice == "12" >>
            latest()
            run()

        choice == "13" >>
            summary()
            run()

        choice == "14" >>
            preview-restock()
            run()

        choice == "15" >>
            toggle-warnings()
            run()

        choice == "16" >>
            print("Goodbye.")

        else >>
            print("Unknown choice.")
            run()
    .
.


run()