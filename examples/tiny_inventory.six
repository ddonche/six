# Tiny Inventory
# Canonical Six specimen

##
Alternate syntax accepted by Six:

    if      ?
    if any  ?*
    else    ??

    and     &&
    or      ||
    not     !

Additional numeric postfix forms not needed by this program:

    x**     square
    x**y    power
    x//     square root

Group passing:

    value(group)      passes the existing Group as one argument
    value([group])    passes a new Group containing that Group
    value(<group>)    opens the Group into separate arguments

Flow:

    value >> function(args)

The flowing value becomes the first argument.

    inventory >> total-value(0 0)

is equivalent to:

    total-value(inventory 0 0)

A flow may continue across lines when >> shows that
the expression is not yet complete.
##

TITLE : "Tiny Inventory"
LOW_STOCK : 3
TARGET_STOCK : 12
HIGH_VALUE : 10
MAX_INVENTORY_VALUE : 10,000

warnings : true
last_sale : number ..

inventory : [
    [
        ["name" "coffee"]
        ["qty" 2]
        ["price" 8.50]
        ["case" 6]
        ["note" "Whole bean"]
    ]
    [
        ["name" "rice"]
        ["qty" 1]
        ["price" 4.25]
        ["case" 12]
    ]
    [
        ["name" "beans"]
        ["qty" 14]
        ["price" 3.75]
        ["case" 6]
        ["note" "Black beans"]
    ]
]


:find(items name i)
    if
        i >= size(items) >> -1
        items[i]["name"] == name >> i
        else >> find(items name (i + 1))
    .
.


:each(items action i)
    if
        i >= size(items) >> ..
        else >>
            action(items[i])
            each(items action (i + 1))
    .
.


:at-most(limit)
    :matches(item)
        item["qty"] <= limit
    .

    matches
.


:starts-with(letter)
    :matches(item)
        item["name"][0] == letter
    .

    matches
.


:priority(item)
    item["qty"] == 0 or item["price"] >= HIGH_VALUE
.


:collect-matching(items predicate i result)
    if
        i >= size(items) >> result

        predicate(items[i]) >>
            insert(result items[i])
            collect-matching(items predicate (i + 1) result)

        else >>
            collect-matching(items predicate (i + 1) result)
    .
.


:matching(items predicate)
    result : []
    collect-matching(items predicate 0 result)
    result
.


:item-value(item)
    (item["qty"] * item["price"])~2
.


:total-value(items i total)
    if
        i >= size(items) >> total
        else >>
            total-value(
                items
                (i + 1)
                (total + item-value(items[i]))
            )
    .
.


:total-units(items i total)
    if
        i >= size(items) >> total
        else >>
            total-units(
                items
                (i + 1)
                (total + items[i]["qty"])
            )
    .
.


:money(value)
    "$" + text(value~2)
.


:average-value()
    if
        size(inventory) == 0 >> 0
        else >> (total-value(inventory 0 0) / size(inventory))~2
    .
.


:average-stock()
    if
        size(inventory) == 0 >> 0
        else >> (total-units(inventory 0 0) / size(inventory))~
    .
.


:reorder-cases(item)
    needed : TARGET_STOCK - item["qty"]

    if
        needed <= 0 >> 0
        else >> (needed / item["case"])^
    .
.


:show-cases(item)
    cases : (item["qty"] / item["case"])_
    loose : item["qty"] % item["case"]

    out(output 
        "Cases: " + text(cases)
        + ", loose: " + text(loose)
     + "\n")
.


:status(item)
    if any
        warnings and item["qty"] == 0 >>
            out(output "  OUT OF STOCK" + "\n")

        warnings and item["qty"] > 0 and item["qty"] <= LOW_STOCK >>
            out(output "  Low stock" + "\n")

        item["qty"] != 0 and item["qty"] % item["case"] != 0 >>
            out(output "  Loose units" + "\n")

        item["price"] >= HIGH_VALUE >>
            out(output "  High-value item" + "\n")

        not has(item "note") >>
            out(output "  No note" + "\n")

        else >>
            out(output "  Normal" + "\n")
    .
.


:show-item(item)
    out(output 
        item["name"]
        + " - "
        + text(item["qty"])
        + " @ "
        + money(item["price"])
        + " = "
        + money(item-value(item))
     + "\n")

    status(item)
.


:show-field(item key)
    if
        has(item key) >>
            out(output key + ": " + text(item[key]) + "\n")

        else >>
            out(output key + ": -" + "\n")
    .
.


:list()
    out(output "" + "\n")
    out(output TITLE + "\n")
    out(output "--------------" + "\n")

    if
        size(inventory) == 0 >> out(output "Inventory is empty." + "\n")
        else >> each(inventory show-item 0)
    .

    out(output "" + "\n")
.


:summary()
    out(output "" + "\n")

    total : total-value(inventory 0 0)

    out(output money(total) + "\n")

    out(output "Average item value: " + money(average-value()) + "\n")
    out(output "Average stock: " + text(average-stock()) + " units" + "\n")

    if
        total > MAX_INVENTORY_VALUE >>
            out(output "Inventory exceeds target value." + "\n")
    .

    if
        last_sale == .. >> out(output "No sales yet." + "\n")
        else >> out(output "Last sale: " + money(last_sale) + "\n")
    .

    out(output "" + "\n")
.


:low-stock()
    predicate : at-most(LOW_STOCK)
    items : matching(inventory predicate)

    out(output "" + "\n")
    out(output "LOW STOCK" + "\n")
    out(output "---------" + "\n")

    if
        size(items) == 0 >> out(output "Nothing is low." + "\n")
        else >> each(items show-item 0)
    .

    out(output "" + "\n")
.


:priority-report()
    items : matching(inventory priority)

    out(output "" + "\n")
    out(output "PRIORITY" + "\n")
    out(output "--------" + "\n")

    if
        size(items) == 0 >> out(output "No priority items." + "\n")
        else >> each(items show-item 0)
    .

    out(output "" + "\n")
.


:initial-report()
    out(output "Initial: ")
    value : in(input)

    if
        size(value) == 0 >>
            out(output "No initial entered." + "\n")

        else >>
            predicate : starts-with(value[0])
            items : matching(inventory predicate)

            if
                size(items) == 0 >> out(output "No matching items." + "\n")
                else >> each(items show-item 0)
            .
    .
.


:latest()
    if
        size(inventory) == 0 >>
            out(output "Inventory is empty." + "\n")

        else >>
            out(output "" + "\n")
            out(output "LATEST ITEM" + "\n")
            out(output "-----------" + "\n")
            show-item(inventory[$])
            out(output "" + "\n")
    .
.


:add-record(name qty price case)
    if
        qty < 0 >> out(output "Quantity cannot be negative." + "\n")
        price < 0 >> out(output "Price cannot be negative." + "\n")
        case <= 0 >> out(output "Case size must be positive." + "\n")

        else >>
            i : find(inventory name 0)

            if
                i >= 0 >>
                    inventory[i]["qty"] = inventory[i]["qty"] + qty
                    out(output "Updated " + name + "." + "\n")

                else >>
                    item : [
                        ["name" name]
                        ["qty" qty]
                        ["price" price]
                        ["case" case]
                    ]

                    insert(inventory item)
                    out(output "Added " + name + "." + "\n")
            .
    .
.


:add-item()
    out(output "Item: ")
    r-name : in(input)
    out(output "Quantity: ")
    r-qty : number(in(input))
    out(output "Price: ")
    r-price : number(in(input))
    out(output "Case size: ")
    r-case : number(in(input))

    record : [
        r-name
        r-qty
        r-price
        r-case
    ]

    add-record(<record>)
.


:remove-item()
    out(output "Remove item: ")
    name : in(input)
    i : find(inventory name 0)

    if
        i >= 0 >>
            remove(inventory i)
            out(output "Removed " + name + "." + "\n")

        else >>
            out(output "No item named " + name + "." + "\n")
    .
.


:change-quantity()
    out(output "Item: ")
    name : in(input)
    i : find(inventory name 0)

    if
        i >= 0 >>
            out(output "New quantity: ")
            qty : number(in(input))

            if
                qty < 0 >> out(output "Quantity cannot be negative." + "\n")
                else >>
                    inventory[i]["qty"] = qty
                    out(output "Quantity changed." + "\n")
            .

        else >>
            out(output "No item named " + name + "." + "\n")
    .
.


:receive-one()
    out(output "Receive item: ")
    name : in(input)
    i : find(inventory name 0)

    if
        i >= 0 >>
            inventory[i]["qty"]++
            out(output "Received one " + name + "." + "\n")

        else >>
            out(output "No item named " + name + "." + "\n")
    .
.


:sell-one()
    out(output "Sell item: ")
    name : in(input)
    i : find(inventory name 0)

    if
        i < 0 >>
            out(output "No item named " + name + "." + "\n")

        inventory[i]["qty"] == 0 >>
            out(output name + " is out of stock." + "\n")

        else >>
            inventory[i]["qty"]--
            last_sale = inventory[i]["price"]
            out(output "Sold one " + name + "." + "\n")
    .
.


:add-note()
    out(output "Item: ")
    name : in(input)
    i : find(inventory name 0)

    if
        i >= 0 >>
            out(output "Note: ")
            inventory[i]["note"] = in(input)
            out(output "Note saved." + "\n")

        else >>
            out(output "No item named " + name + "." + "\n")
    .
.


:inspect()
    out(output "Item: ")
    name : in(input)
    i : find(inventory name 0)

    if
        i >= 0 >>
            item : inventory[i]

            out(output "" + "\n")
            show-field(item "name")
            show-field(item "qty")
            show-field(item "price")
            show-field(item "case")
            show-field(item "note")
            show-cases(item)

            out(output "Value: " + money(item-value(item)) + "\n")
            out(output "Reorder cases: " + text(reorder-cases(item)) + "\n")

            status(item)
            out(output "" + "\n")

        else >>
            out(output "Not found." + "\n")
    .
.


:preview-restock()
    preview :: inventory

    out(output "Preview item: ")
    name : in(input)
    i : find(preview name 0)

    if
        i >= 0 >>
            out(output "Units to receive: ")
            qty : number(in(input))

            if
                qty < 0 >>
                    out(output "Quantity cannot be negative." + "\n")

                else >>
                    preview[i]["qty"] = preview[i]["qty"] + qty

                    out(output 
                        "Current value: "
                        + money(total-value(inventory 0 0))
                     + "\n")

                    out(output 
                        "Projected value: "
                        + money(total-value(preview 0 0))
                     + "\n")
            .

        else >>
            out(output "No item named " + name + "." + "\n")
    .
.


:toggle-warnings()
    if
        warnings >>
            warnings = false
            out(output "Warnings off." + "\n")

        else >>
            warnings = true
            out(output "Warnings on." + "\n")
    .
.


:menu()
    out(output "" + "\n")
    out(output "1. List inventory" + "\n")
    out(output "2. Add item" + "\n")
    out(output "3. Change quantity" + "\n")
    out(output "4. Receive one" + "\n")
    out(output "5. Sell one" + "\n")
    out(output "6. Remove item" + "\n")
    out(output "7. Inspect item" + "\n")
    out(output "8. Add note" + "\n")
    out(output "9. Low-stock report" + "\n")
    out(output "10. Priority report" + "\n")
    out(output "11. Items by initial" + "\n")
    out(output "12. Latest item" + "\n")
    out(output "13. Inventory summary" + "\n")
    out(output "14. Preview restock" + "\n")
    out(output "15. Toggle warnings" + "\n")
    out(output "16. Quit" + "\n")
    out(output "" + "\n")
.


:run()
    menu()
    out(output "> ")
    choice : in(input)

    if
        choice == "1" >>
            list()
            run()

        choice == "2" >>
            add-item()
            run()

        choice == "3" >>
            change-quantity()
            run()

        choice == "4" >>
            receive-one()
            run()

        choice == "5" >>
            sell-one()
            run()

        choice == "6" >>
            remove-item()
            run()

        choice == "7" >>
            inspect()
            run()

        choice == "8" >>
            add-note()
            run()

        choice == "9" >>
            low-stock()
            run()

        choice == "10" >>
            priority-report()
            run()

        choice == "11" >>
            initial-report()
            run()

        choice == "12" >>
            latest()
            run()

        choice == "13" >>
            summary()
            run()

        choice == "14" >>
            preview-restock()
            run()

        choice == "15" >>
            toggle-warnings()
            run()

        choice == "16" >>
            out(output "Goodbye." + "\n")

        else >>
            out(output "Unknown choice." + "\n")
            run()
    .
.


run()