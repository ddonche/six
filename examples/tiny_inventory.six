# Tiny Inventory
# Canonical Six specimen

##
Alternate syntax accepted by Six:

    if      ?
    if any  ?*
    else    ??

    and     &&
    or      ||
    not     !

Additional numeric postfix forms not needed by this program:

    x**     square
    x**y    power
    x//     square root

Group passing:

    value(group)      passes the existing Group as one argument
    value([group])    passes a new Group containing that Group
    value(<group>)    opens the Group into separate arguments

Flow:

    value >> function(args)

The flowing value becomes the first argument.

    inventory >> total-value(0 0)

is equivalent to:

    total-value(inventory 0 0)

A flow may continue across lines when >> shows that
the expression is not yet complete.
##

## Six has no print or input. I/O flows through the runtime channels
   out(output …) and in(input); line/ask are ordinary userland helpers
   (the same ones reference/io.six provides). `in(input)` yields a chunk of
   text, so the reader keeps the unread tail in a one-cell Group. ##

input_buffer : [""]

:line(s)
    out(output s)
    out(output "\n")
.

:ask(prompt)
    out(output prompt)
    _next-line()
.

:_next-line()
    at : _find-newline(input_buffer[0] 0)
    if
        at >= 0 >>
            result : _slice(input_buffer[0] 0 at "")
            input_buffer[0] = _slice(input_buffer[0] (at + 1) size(input_buffer[0]) "")
            result
        else >>
            chunk : in(input)
            if
                chunk == .. >>
                    rest : input_buffer[0]
                    input_buffer[0] = ""
                    rest
                else >>
                    input_buffer[0] = input_buffer[0] + chunk
                    _next-line()
            .
    .
.

:_find-newline(s i)
    if
        i >= size(s) >> -1
        s[i] == "\n" >> i
        else >> _find-newline(s (i + 1))
    .
.

:_slice(s i end acc)
    if
        i >= end >> acc
        else >> _slice(s (i + 1) end acc + s[i])
    .
.


TITLE : "Tiny Inventory"
LOW_STOCK : 3
TARGET_STOCK : 12
HIGH_VALUE : 10
MAX_INVENTORY_VALUE : 10,000

warnings : true
last_sale : number ..

inventory : [
    [
        ["name" "coffee"]
        ["qty" 2]
        ["price" 8.50]
        ["case" 6]
        ["note" "Whole bean"]
    ]
    [
        ["name" "rice"]
        ["qty" 1]
        ["price" 4.25]
        ["case" 12]
    ]
    [
        ["name" "beans"]
        ["qty" 14]
        ["price" 3.75]
        ["case" 6]
        ["note" "Black beans"]
    ]
]


:find(items name i)
    if
        i >= size(items) >> -1
        items[i]["name"] == name >> i
        else >> find(items name (i + 1))
    .
.


:each(items action i)
    if
        i >= size(items) >> ..
        else >>
            action(items[i])
            each(items action (i + 1))
    .
.


:at-most(limit)
    :matches(item)
        item["qty"] <= limit
    .

    matches
.


:starts-with(letter)
    :matches(item)
        item["name"][0] == letter
    .

    matches
.


:priority(item)
    item["qty"] == 0 or item["price"] >= HIGH_VALUE
.


:collect-matching(items predicate i result)
    if
        i >= size(items) >> result

        predicate(items[i]) >>
            insert(result items[i])
            collect-matching(items predicate (i + 1) result)

        else >>
            collect-matching(items predicate (i + 1) result)
    .
.


:matching(items predicate)
    result : []
    collect-matching(items predicate 0 result)
    result
.


:item-value(item)
    (item["qty"] * item["price"])~2
.


:total-value(items i total)
    if
        i >= size(items) >> total
        else >>
            total-value(
                items
                (i + 1)
                (total + item-value(items[i]))
            )
    .
.


:total-units(items i total)
    if
        i >= size(items) >> total
        else >>
            total-units(
                items
                (i + 1)
                (total + items[i]["qty"])
            )
    .
.


:money(value)
    "$" + text(value~2)
.


:average-value()
    if
        size(inventory) == 0 >> 0
        else >> (total-value(inventory 0 0) / size(inventory))~2
    .
.


:average-stock()
    if
        size(inventory) == 0 >> 0
        else >> (total-units(inventory 0 0) / size(inventory))~
    .
.


:reorder-cases(item)
    needed : TARGET_STOCK - item["qty"]

    if
        needed <= 0 >> 0
        else >> (needed / item["case"])^
    .
.


:show-cases(item)
    cases : (item["qty"] / item["case"])_
    loose : item["qty"] % item["case"]

    line(
        "Cases: " + text(cases)
        + ", loose: " + text(loose)
    )
.


:status(item)
    if any
        warnings and item["qty"] == 0 >>
            line("  OUT OF STOCK")

        warnings and item["qty"] > 0 and item["qty"] <= LOW_STOCK >>
            line("  Low stock")

        item["qty"] != 0 and item["qty"] % item["case"] != 0 >>
            line("  Loose units")

        item["price"] >= HIGH_VALUE >>
            line("  High-value item")

        not has(item "note") >>
            line("  No note")

        else >>
            line("  Normal")
    .
.


:show-item(item)
    line(
        item["name"]
        + " - "
        + text(item["qty"])
        + " @ "
        + money(item["price"])
        + " = "
        + money(item-value(item))
    )

    status(item)
.


:show-field(item key)
    if
        has(item key) >>
            line(key + ": " + text(item[key]))

        else >>
            line(key + ": -")
    .
.


:list()
    line("")
    line(TITLE)
    line("--------------")

    if
        size(inventory) == 0 >> line("Inventory is empty.")
        else >> each(inventory show-item 0)
    .

    line("")
.


:summary()
    line("")

    total : total-value(inventory 0 0)

    total >>
    money() >>
    line()

    line("Average item value: " + money(average-value()))
    line("Average stock: " + text(average-stock()) + " units")

    if
        total > MAX_INVENTORY_VALUE >>
            line("Inventory exceeds target value.")
    .

    if
        last_sale == .. >> line("No sales yet.")
        else >> line("Last sale: " + money(last_sale))
    .

    line("")
.


:low-stock()
    predicate : at-most(LOW_STOCK)
    items : matching(inventory predicate)

    line("")
    line("LOW STOCK")
    line("---------")

    if
        size(items) == 0 >> line("Nothing is low.")
        else >> each(items show-item 0)
    .

    line("")
.


:priority-report()
    items : matching(inventory priority)

    line("")
    line("PRIORITY")
    line("--------")

    if
        size(items) == 0 >> line("No priority items.")
        else >> each(items show-item 0)
    .

    line("")
.


:initial-report()
    value : ask("Initial: ")

    if
        size(value) == 0 >>
            line("No initial entered.")

        else >>
            predicate : starts-with(value[0])
            items : matching(inventory predicate)

            if
                size(items) == 0 >> line("No matching items.")
                else >> each(items show-item 0)
            .
    .
.


:latest()
    if
        size(inventory) == 0 >>
            line("Inventory is empty.")

        else >>
            line("")
            line("LATEST ITEM")
            line("-----------")
            show-item(inventory[$])
            line("")
    .
.


:add-record(name qty price case)
    if
        qty < 0 >> line("Quantity cannot be negative.")
        price < 0 >> line("Price cannot be negative.")
        case <= 0 >> line("Case size must be positive.")

        else >>
            i : find(inventory name 0)

            if
                i >= 0 >>
                    inventory[i]["qty"] = inventory[i]["qty"] + qty
                    line("Updated " + name + ".")

                else >>
                    item : [
                        ["name" name]
                        ["qty" qty]
                        ["price" price]
                        ["case" case]
                    ]

                    insert(inventory item)
                    line("Added " + name + ".")
            .
    .
.


:add-item()
    record : [
        ask("Item: ")
        number(ask("Quantity: "))
        number(ask("Price: "))
        number(ask("Case size: "))
    ]

    add-record(<record>)
.


:remove-item()
    name : ask("Remove item: ")
    i : find(inventory name 0)

    if
        i >= 0 >>
            remove(inventory i)
            line("Removed " + name + ".")

        else >>
            line("No item named " + name + ".")
    .
.


:change-quantity()
    name : ask("Item: ")
    i : find(inventory name 0)

    if
        i >= 0 >>
            qty : number(ask("New quantity: "))

            if
                qty < 0 >> line("Quantity cannot be negative.")
                else >>
                    inventory[i]["qty"] = qty
                    line("Quantity changed.")
            .

        else >>
            line("No item named " + name + ".")
    .
.


:receive-one()
    name : ask("Receive item: ")
    i : find(inventory name 0)

    if
        i >= 0 >>
            inventory[i]["qty"]++
            line("Received one " + name + ".")

        else >>
            line("No item named " + name + ".")
    .
.


:sell-one()
    name : ask("Sell item: ")
    i : find(inventory name 0)

    if
        i < 0 >>
            line("No item named " + name + ".")

        inventory[i]["qty"] == 0 >>
            line(name + " is out of stock.")

        else >>
            inventory[i]["qty"]--
            last_sale = inventory[i]["price"]
            line("Sold one " + name + ".")
    .
.


:add-note()
    name : ask("Item: ")
    i : find(inventory name 0)

    if
        i >= 0 >>
            inventory[i]["note"] = ask("Note: ")
            line("Note saved.")

        else >>
            line("No item named " + name + ".")
    .
.


:inspect()
    name : ask("Item: ")
    i : find(inventory name 0)

    if
        i >= 0 >>
            item : inventory[i]

            line("")
            show-field(item "name")
            show-field(item "qty")
            show-field(item "price")
            show-field(item "case")
            show-field(item "note")
            show-cases(item)

            line("Value: " + money(item-value(item)))
            line("Reorder cases: " + text(reorder-cases(item)))

            status(item)
            line("")

        else >>
            line("Not found.")
    .
.


:preview-restock()
    preview :: inventory

    name : ask("Preview item: ")
    i : find(preview name 0)

    if
        i >= 0 >>
            qty : number(ask("Units to receive: "))

            if
                qty < 0 >>
                    line("Quantity cannot be negative.")

                else >>
                    preview[i]["qty"] = preview[i]["qty"] + qty

                    line(
                        "Current value: "
                        + money(total-value(inventory 0 0))
                    )

                    line(
                        "Projected value: "
                        + money(total-value(preview 0 0))
                    )
            .

        else >>
            line("No item named " + name + ".")
    .
.


:toggle-warnings()
    if
        warnings >>
            warnings = false
            line("Warnings off.")

        else >>
            warnings = true
            line("Warnings on.")
    .
.


:menu()
    line("")
    line("1. List inventory")
    line("2. Add item")
    line("3. Change quantity")
    line("4. Receive one")
    line("5. Sell one")
    line("6. Remove item")
    line("7. Inspect item")
    line("8. Add note")
    line("9. Low-stock report")
    line("10. Priority report")
    line("11. Items by initial")
    line("12. Latest item")
    line("13. Inventory summary")
    line("14. Preview restock")
    line("15. Toggle warnings")
    line("16. Quit")
    line("")
.


:run()
    menu()
    choice : ask("> ")

    if
        choice == "1" >>
            list()
            run()

        choice == "2" >>
            add-item()
            run()

        choice == "3" >>
            change-quantity()
            run()

        choice == "4" >>
            receive-one()
            run()

        choice == "5" >>
            sell-one()
            run()

        choice == "6" >>
            remove-item()
            run()

        choice == "7" >>
            inspect()
            run()

        choice == "8" >>
            add-note()
            run()

        choice == "9" >>
            low-stock()
            run()

        choice == "10" >>
            priority-report()
            run()

        choice == "11" >>
            initial-report()
            run()

        choice == "12" >>
            latest()
            run()

        choice == "13" >>
            summary()
            run()

        choice == "14" >>
            preview-restock()
            run()

        choice == "15" >>
            toggle-warnings()
            run()

        choice == "16" >>
            line("Goodbye.")

        else >>
            line("Unknown choice.")
            run()
    .
.


run()